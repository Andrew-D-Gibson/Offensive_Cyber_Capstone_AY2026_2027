# Copy this file to .env and fill in the values you need.
# .env is gitignored — it's the right place for anything you don't want
# to commit, like an HF_AUTH_TOKEN for a gated model.

# Backend: "ollama" or "huggingface"
BACKEND=ollama

# Model name. For ollama: a locally-pulled tag (e.g. llama3.1:8b) — it
# must already exist via `ollama pull <tag>` or every call 404s.
# For huggingface: a MODEL_REGISTRY alias (see fair_llm's
# huggingface_adapter.py, e.g. qwen25-7b, phi4, mistral-7b) or a full
# HuggingFace repo id (e.g. meta-llama/Llama-3.3-70B-Instruct).
MODEL=llama3.1:8b

# --- HuggingFace-only settings (ignored when BACKEND=ollama) ---
# Load the model in 4-bit quantization. Needs bitsandbytes + a CUDA GPU.
HF_QUANTIZED=false
# Auth token for gated HuggingFace models (e.g. the Llama family).
# Leave blank for ungated models.
HF_AUTH_TOKEN=

# Number of trials to run per architecture.
TRIALS=5

# Which architecture(s) to run: "single", "multi", or "both".
ARCHITECTURE=both

# Where to write the JSONL results file and per-trial trace JSON files.
OUT_FILE=results.jsonl
TRACE_DIR=traces

# Print extra info (e.g. the multi-agent manager's final answer).
VERBOSE=false

# Logging verbosity for live step-by-step console output.
# DEBUG shows the most detail, INFO is the default, WARNING is quietest.
LOG_LEVEL=INFO
